<!DOCTYPE html>
<html>
<head>
  <title>Update Room Status</title>
  <style>
    body {background:#f0f4f8; font-family:Segoe UI; display:flex; justify-content:center; align-items:center; min-height:100vh; margin:0;}
    .box {background:white; padding:40px 30px; border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.1); width:100%; max-width:400px; text-align:center;}
    h2 {color:#2c3e50; margin-bottom:25px;}
    .ok {color:#27ae60; background:#eafaf1; padding:10px; border-radius:6px; margin-bottom:20px;}
    label {display:block; text-align:left; font-weight:bold; margin:20px 0 5px; color:#34495e;}
    select {width:100%; padding:12px; border:1px solid #ddd; border-radius:8px; font-size:16px;}
    button {width:100%; padding:13px; margin-top:25px; background:#3498db; color:white; border:none; border-radius:8px; font-size:17px; font-weight:bold; cursor:pointer;}
    button:hover {background:#2980b9;}
    .back {display:inline-block; margin-top:25px; color:#3498db; text-decoration:none; font-weight:bold;}
  </style>
</head>
<body>
  <div class="box">
    <h2>🔄 Update Status:<br><%= room.room_name %></h2>
    <% if (success) { %><div class="ok"><%= success %></div><% } %>
    
    <p><strong>Current Status:</strong> <%= room.current_status || 'VACANT' %></p>
    
    <form method="POST">
      <label>Select New Status:</label>
      <select name="new_status" required>
        <option value="VACANT" <%= room.current_status === 'VACANT' ? 'selected' : '' %>>✅ VACANT</option>
        <option value="OCCUPIED" <%= room.current_status === 'OCCUPIED' ? 'selected' : '' %>>🔴 OCCUPIED</option>
      </select>
      <button type="submit">💾 Save Change</button>
    </form>
    
    <a href="/dashboard" class="back">⬅️ Back to Dashboard</a>
  </div>
</body>
</html>