<!DOCTYPE html>
<html>
<head>
  <title>Login - Classroom Monitor</title>
  <style>
    body {background:#f0f4f8; font-family:Segoe UI; display:flex; justify-content:center; align-items:center; min-height:100vh; margin:0;}
    .box {background:white; padding:35px; border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.1); width:340px;}
    h2 {text-align:center; color:#2c3e50; margin-bottom:25px;}
    .err {color:red; text-align:center; margin-bottom:15px;}
    label {font-weight:500; color:#333;}
    input {width:100%; padding:12px; margin:8px 0 15px; border:1px solid #ddd; border-radius:8px; font-size:16px;}
    button {width:100%; padding:12px; background:#3498db; color:white; border:none; border-radius:8px; font-size:17px; font-weight:bold; cursor:pointer;}
    button:hover {background:#2980b9;}
  </style>
</head>
<body>
  <div class="box">
    <h2>🔐 System Login</h2>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <form method="POST">
      <label>Username</label>
      <input type="text" name="username" required>
      <label>Password</label>
      <input type="password" name="password" required>
      <button type="submit">Login</button>
    </form>
  </div>
</body>
</html>
